# ShipTrack Pro licensing platform — required configuration.
# Copy to .env for local work. Never commit a filled-in copy.
#
# Generate ED25519_KEY_ID, ED25519_PRIVATE_KEY, LICENSE_KEY_SECRET and
# GITHUB_WEBHOOK_SECRET in one go with:  npm run keys:generate
# Step-by-step, including what to do with the public key: docs/operations/key-setup.md

# --- Database (Neon, project "ShipTrack Pro", PostgreSQL 18, aws-eu-west-2) ---
# Pooled URL for the running app; direct URL for drizzle-kit and the CLIs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Entitlement signing ---
# PKCS#8 PEM. The public half is compiled into the plugin as a constant and is
# never fetched over the network.
ED25519_PRIVATE_KEY=
# Identifies which key signed a token, so the pair can be rotated later.
# Required, and deliberately blank here: copy the value from the same
# `npm run keys:generate` run that produced the private key above. A key id that
# does not match the key filed under it in the plugin refuses every licence.
ED25519_KEY_ID=

# --- Licence key storage ---
# 32 bytes, base64. Encrypts the key at rest so a database dump is not a
# licence generator.
LICENSE_KEY_SECRET=

# --- Cloudflare R2 (bucket: shiptrack-app-store) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shiptrack-app-store
R2_PRESIGN_TTL_SECONDS=900

# --- GitHub release ingestion ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT with Contents: read on the plugin repository.
GITHUB_RELEASE_PAT=
GITHUB_OWNER=Micah224
GITHUB_REPO=ShipTrack-Pro

# --- Public identity ---
# Absolute origin of this deployment. Used to build download and asset URLs
# handed to WordPress, so it must be the URL customer sites can actually reach.
PUBLIC_APP_URL=https://ship-track-app.vercel.app

# --- Admin console ---
# The single operator login. Generate the hash with:
#   read -rs PW && printf '%s' "$PW" | npm run admin:hash
# The plaintext password is stored nowhere; only this scrypt digest is.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Signs the session cookie. At least 32 characters; `openssl rand -hex 32`.
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_MINUTES=15

# --- Scheduled maintenance ---
# Vercel Cron sends this as `Authorization: Bearer <value>`. Without it the
# maintenance endpoint refuses to run rather than running unauthenticated.
# Any long random string; `openssl rand -hex 32` is fine.
CRON_SECRET=

# --- Rate limiting ---
# `observe` counts and reports without ever refusing; `enforce` refuses with 429.
# Ships as observe: every limit below is inferred from the plugin's cron cadence,
# not measured against the live fleet, and the rate_counters table is the
# instrument for taking that measurement before enforcement is switched on.
RATE_LIMIT_MODE=observe
# Per-licence overrides, for incident response without a deploy. Unset means the
# computed default, which scales with the licence's seat count.
RATE_LIMIT_ACTIVATE=
RATE_LIMIT_HEARTBEAT=
RATE_LIMIT_UPDATES=
RATE_LIMIT_DEACTIVATE=
RATE_LIMIT_INSTALL=
RATE_LIMIT_MISS=

# --- Policy knobs (all optional; defaults shown) ---
TOKEN_TTL_DAYS=7
DOWNLOAD_TOKEN_TTL_MINUTES=15
SEAT_RECLAIM_DAYS=21

# --- Plugin metadata surfaced in the WordPress update modal ---
PLUGIN_MIN_PHP=8.1
PLUGIN_MIN_WP=6.5
PLUGIN_TESTED_UP_TO=7.0
PLUGIN_AUTHOR=ShipTrack Pro
PLUGIN_HOMEPAGE=
PLUGIN_DESCRIPTION=
