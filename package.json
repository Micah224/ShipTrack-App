{
	"name": "shiptrack-app",
	"description": "ShipTrack Pro licensing, entitlement and update-distribution platform.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:bundle",
		"lint": "eslint .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"keys:generate": "node --env-file-if-exists=.env --experimental-strip-types scripts/generate-keypair.ts",
		"license:mint": "node --env-file-if-exists=.env --experimental-strip-types scripts/mint-license.ts",
		"admin:hash": "node --env-file-if-exists=.env --experimental-strip-types scripts/hash-admin-password.ts",
		"verify:bundle": "node --no-experimental-require-module scripts/verify-bundle.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1126.0",
		"@aws-sdk/s3-request-presigner": "^3.1126.0",
		"@neondatabase/serverless": "^1.1.0",
		"@octokit/rest": "^22.0.1",
		"drizzle-orm": "^0.45.2",
		"marked": "^18.0.11",
		"sanitize-html": "^2.17.7"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.10.1",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
